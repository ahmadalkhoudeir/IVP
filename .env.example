# Synthetic configuration only. Never put real credentials or API keys here
# or in any file that gets committed.

# Session signing secret for the staff dashboard (auth/ session cookies).
# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
IVP_SESSION_SECRET=change-me-in-a-real-deployment

# SQLite file path (default persistence, see docs/decisions/persistence.md)
IVP_DATABASE_PATH=./demo_data/ivp.db

# Verification attempt tuning
IVP_CONFIRMATION_TIMEOUT_SECONDS=240
IVP_MAX_CONFIRMATION_ATTEMPTS=3

# Seed demo accounts on startup (agent/supervisor/admin) with synthetic
# credentials for out-of-the-box docker-compose demo use. Set to false for
# anything resembling a real deployment.
IVP_SEED_DEMO_DATA=true
